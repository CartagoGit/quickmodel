{
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"files.exclude": {
		"**/node_modules": true,
		"**/dist": true,
		"**/.turbo": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/dist": true,
		"**/coverage": true,
		"**/docs-vitepress/dist": true
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[markdown]": {
		"editor.wordWrap": "on"
	},
	"chat.agent.maxRequests": 10000,
	"chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
	"chat.tools.edits.autoApprove": {
		"**": true
	},
	"chat.tools.global.autoApprove": true,
	"chat.tools.urls.autoApprove": {
		"*": true
	},
	"chat.tools.terminal.autoApprove": {
		"bun": true,
		"bunx": true,
		"yarn": true,
		"pnpm": true,
		"pnpx": true,
		"npm": true,
		"npx": true,
		"node": true,
		"nx": true,
		"docker": true,
		"docker-compose": true,
		"git": true,
		"exit": true,
		"rm": true,
		"rm -rf": true,
		"mkdir": true,
		"mv": true,
		"cp": true,
		"cat": true,
		"ls": true,
		"ll": true,
		"la": true,
		"find": true,
		"grep": true,
		"echo": true,
		"echo *": true,
		"touch": true,
		"chmod": true,
		"chown": true,
		"kill": true,
		"pkill": true,
		"killall": true,
		"cd": true,
		"cd *": true,
		"pwd": true,
		"which": true,
		"type": true,
		"wc": true,
		"head": true,
		"tail": true,
		"sort": true,
		"uniq": true,
		"awk": true,
		"sed": true,
		"tee": true,
		"source": true,
		"export": true,
		"env": true,
		"printenv": true,
		"ps": true,
		"jobs": true,
		"fg": true,
		"bg": true,
		"lsof": true,
		"curl": true,
		"wget": true,
		"ssh": true,
		"scp": true,
		"rsync": true,
		"tar": true,
		"gzip": true,
		"gunzip": true,
		"unzip": true,
		"zip": true,
		"diff": true,
		"patch": true,
		"ln": true,
		"stat": true,
		"file": true,
		"xargs": true,
		"tr": true,
		"cut": true,
		"paste": true,
		"jq": true,
		"bat": true,
		"batcat": true,
		"less": true,
		"more": true,
		"open": true,
		"xdg-open": true,
		"code": true,
		"tsc": true,
		"eslint": true,
		"prettier": true,
		"typedoc": true,
		"vite": true,
		"vitest": true,
		"jest": true,
		"tsx": true,
		"ts-node": true,
		"q": true
	}
}
